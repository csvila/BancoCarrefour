<?xml version="1.0" encoding="utf-8"?>
<!--
  Fonte única e explícita de pacotes + package source mapping (mitigação de dependency confusion, TM-023 / ADR-0013).
  Um feed interno futuro deve ser adicionado com mapeamento por prefixo reservado (ex.: BancoCarrefour.*), nunca "*".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
