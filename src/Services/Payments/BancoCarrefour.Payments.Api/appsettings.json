{
  // Sem segredos neste arquivo. Valores por ambiente via variáveis de ambiente/ConfigMap;
  // segredos (quando existirem) somente via secret manager/KMS.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    // URL HTTPS do IdP OIDC e audience exata desta API (ADR-0006). Obrigatórios: o serviço não sobe sem eles.
    "Authority": "",
    "Audience": "",
    "ClockSkewSeconds": 30
  }
}
