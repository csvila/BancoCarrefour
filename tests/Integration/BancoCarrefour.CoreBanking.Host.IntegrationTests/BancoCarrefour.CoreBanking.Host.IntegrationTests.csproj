<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BancoCarrefour.CoreBanking.Host.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Services\CoreBanking\BancoCarrefour.CoreBanking.Host\BancoCarrefour.CoreBanking.Host.csproj" />
  </ItemGroup>

  <!-- TestKit compartilhado por código-fonte (ver projeto de integração da Payments API). Grpc.Net.Client e
       Grpc.HealthCheck chegam transitivamente via Grpc.AspNetCore/Grpc.AspNetCore.HealthChecks do host. -->
  <ItemGroup>
    <Compile Include="$(TestKitDir)**\*.cs" Link="TestKit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
